From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jetbee <7734987+jetbee@users.noreply.github.com>
Date: Sun, 4 Oct 2026 11:12:11 +0000
Subject: [PATCH 1/3] Support an aarch64 Linux build host

Soong already runs on linux/arm64 (as linux_musl-arm64); the pieces below were still
x86-only.

- rust: use the aarch64-unknown-linux-musl std for the arm64 host, skip the
  linux-musl-x86 branch there, and set RUSTC_BOOTSTRAP=1 (the upstream stable rustc
  rejects the -Z options Android's toolchain accepts).
- genrule: an arm64 host has no second (32-bit) host arch, so host_second_srcs are
  not an error.
- android/paths.go: install Common-arch host modules into the arm64 host directory.
- android/rule_builder.go, cc/gen.go: the arm64 build-tools (bison, m4, ...) are linked
  against musl and find the loader and libc++ relative to the tool; copy them into the
  sbox sandbox next to it.

Assisted-by: LLM
---
 android/paths.go          |  4 ++++
 android/rule_builder.go   | 11 ++++++++++-
 cc/gen.go                 |  7 +++++++
 genrule/genrule.go        |  5 +++++
 rust/builder.go           |  5 +++++
 rust/toolchain_library.go |  5 ++++-
 6 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/android/paths.go b/android/paths.go
index 12d15ad..e378e5b 100644
--- a/android/paths.go
+++ b/android/paths.go
@@ -2094,6 +2094,10 @@ func pathForInstall(ctx PathContext, os OsType, arch ArchType, partition string,
 		archName := arch.String()
 		if os.Class == Host && (arch == X86_64 || arch == Common) {
 			archName = "x86"
+			if ctx.Config().BuildArch == Arm64 {
+				// Common (e.g. Java) modules share the arm64 host tools' directory.
+				archName = "arm64"
+			}
 		}
 		partitionPaths = []string{"host", osName + "-" + archName, partition}
 	}
diff --git a/android/rule_builder.go b/android/rule_builder.go
index fec46ca..894b7a3 100644
--- a/android/rule_builder.go
+++ b/android/rule_builder.go
@@ -1452,7 +1452,16 @@ func (c *RuleBuilderCommand) builtToolWithoutDeps(tool string) *RuleBuilderComma
 //
 //	cmd.Tool(ctx.Config().PrebuiltBuildTool(ctx, tool))
 func (c *RuleBuilderCommand) PrebuiltBuildTool(ctx PathContext, tool string) *RuleBuilderCommand {
-	return c.Tool(ctx.Config().PrebuiltBuildTool(ctx, tool))
+	c.Tool(ctx.Config().PrebuiltBuildTool(ctx, tool))
+	if ctx.Config().BuildArch == Arm64 {
+		// The arm64 build-tools are dynamically linked against musl and find the
+		// loader and libc++ through an rpath relative to the tool, so they have to
+		// be copied into the sandbox next to it.
+		libDir := PathForSource(ctx, "prebuilts/build-tools", ctx.Config().PrebuiltOS(), "lib64")
+		c.ImplicitTool(libDir.Join(ctx, "libc_musl.so"))
+		c.ImplicitTool(libDir.Join(ctx, "libc++.so"))
+	}
+	return c
 }
 
 // Input adds the specified input path to the command line.  The path will also be added to the dependencies returned by
diff --git a/cc/gen.go b/cc/gen.go
index a5c9a4a..1618a22 100644
--- a/cc/gen.go
+++ b/cc/gen.go
@@ -107,6 +107,13 @@ func genYacc(ctx android.ModuleContext, rule *android.RuleBuilder, yaccFile andr
 		Flag("-o").Output(outFile).Input(yaccFile).
 		Implicits(ctx.GlobFilesOutsideModuleDir("prebuilts/build-tools/common/bison/**/*", nil))
 
+	if ctx.Config().BuildArch == android.Arm64 {
+		// m4 is run from its in-tree path, where it looks for the musl loader.
+		libDir := android.PathForSource(ctx, "prebuilts/build-tools", ctx.Config().PrebuiltOS(), "lib64")
+		cmd.Implicit(libDir.Join(ctx, "libc_musl.so"))
+		cmd.Implicit(libDir.Join(ctx, "libc++.so"))
+	}
+
 	return ret
 }
 
