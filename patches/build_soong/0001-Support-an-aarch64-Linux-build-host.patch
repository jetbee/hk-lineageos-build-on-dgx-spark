+++ b/genrule/genrule.go
@@ -496,6 +496,11 @@ func (g *Module) generateCommonBuildActions(ctx android.ModuleContext) {
 				Context: ctx, Paths: []string{in}, ExcludePaths: exclude, IncludeDirs: includeDirInPaths,
 			})
 			if len(missingDeps) > 0 {
