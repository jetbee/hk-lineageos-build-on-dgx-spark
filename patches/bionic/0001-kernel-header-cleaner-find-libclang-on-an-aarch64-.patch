From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jetbee <7734987+jetbee@users.noreply.github.com>
Date: Mon, 5 Oct 2026 02:57:39 +0000
Subject: [PATCH] kernel header cleaner: find libclang on an aarch64 host

libc/kernel/tools/cpp.py looks for libclang.so in the x86 clang directory. Use the
host prebuilt architecture so that an aarch64 host finds the arm64 clang.

Assisted-by: LLM
---
 libc/kernel/tools/cpp.py | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/libc/kernel/tools/cpp.py b/libc/kernel/tools/cpp.py
index 39e5228..17bcb54 100755
--- a/libc/kernel/tools/cpp.py
+++ b/libc/kernel/tools/cpp.py
@@ -4,6 +4,7 @@
 import ctypes
 import logging
 import os
+import platform
 import re
 import site
 import unittest
@@ -13,8 +14,11 @@ top = os.getenv('ANDROID_BUILD_TOP')
 if top is None:
     utils.panic('ANDROID_BUILD_TOP not set.\n')
 
+host_tag = 'linux-arm64' if platform.machine() in ('aarch64', 'arm64') else 'linux-x86'
+clang_dir = os.path.join(top, 'prebuilts/clang/host', host_tag, 'clang-stable')
+
 # Set up the env vars for libclang.
-site.addsitedir(os.path.join(top, 'prebuilts/clang/host/linux-x86/clang-stable/lib/python3/site-packages/'))
+site.addsitedir(os.path.join(clang_dir, 'lib/python3/site-packages/'))
 
 import clang.cindex
 from clang.cindex import conf
@@ -28,7 +32,7 @@ from clang.cindex import TranslationUnit
 
 # Set up LD_LIBRARY_PATH to include libclang.so, libLLVM.so, and etc.
 # Note that setting LD_LIBRARY_PATH with os.putenv() sometimes doesn't help.
-clang.cindex.Config.set_library_file(os.path.join(top, 'prebuilts/clang/host/linux-x86/clang-stable/lib/libclang.so'))
+clang.cindex.Config.set_library_file(os.path.join(clang_dir, 'lib/libclang.so'))
 
 from defaults import *
 
