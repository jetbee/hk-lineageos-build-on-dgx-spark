From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jetbee <7734987+jetbee@users.noreply.github.com>
Date: Sun, 4 Oct 2026 11:12:11 +0000
Subject: [PATCH] Support an aarch64 Linux build host

Treat aarch64 Linux as HOST_ARCH=arm64 with HOST_PREBUILT_ARCH=arm64 (no second host
arch), take the host prebuilts from linux-arm64, and add core/clang/HOST_arm64.mk.
core/binary.mk, core/clang/config.mk and core/install_jni_libs_internal.mk used a
hard-coded -x86 suffix for the clang and JNI directories; use HOST_PREBUILT_ARCH.
HOST_OUT is set to out/host/linux_musl-arm64 to match the directory Soong uses.

Assisted-by: LLM
---
 core/binary.mk                    |  4 ++--
 core/clang/HOST_arm64.mk          |  2 ++
 core/clang/config.mk              |  4 ++--
 core/envsetup.mk                  | 14 ++++++++++++++
 core/install_jni_libs_internal.mk |  2 +-
 envsetup.sh                       |  5 ++++-
 6 files changed, 25 insertions(+), 6 deletions(-)
 create mode 100644 core/clang/HOST_arm64.mk

diff --git a/core/binary.mk b/core/binary.mk
index cb23c45..9837f3d 100644
--- a/core/binary.mk
+++ b/core/binary.mk
@@ -266,7 +266,7 @@ ifneq ($(LOCAL_SDK_VERSION),)
     my_ndk_stl_include_path := $(my_ndk_source_root)/cxx-stl/system/include
     my_system_shared_libraries += libstdc++
   else ifneq (,$(filter c++_%, $(LOCAL_NDK_STL_VARIANT)))
-    my_llvm_dir := $(LLVM_PREBUILTS_BASE)/$(BUILD_OS)-x86/$(LLVM_PREBUILTS_VERSION)
+    my_llvm_dir := $(LLVM_PREBUILTS_BASE)/$(BUILD_OS)-$(HOST_PREBUILT_ARCH)/$(LLVM_PREBUILTS_VERSION)
     my_libcxx_arch_dir := $(my_llvm_dir)/android_libc++/ndk/$($(LOCAL_2ND_ARCH_VAR_PREFIX)PREBUILT_LIBCXX_ARCH_DIR)
 
     # Include the target-specific __config_site file followed by the generic libc++ headers.
@@ -1780,7 +1780,7 @@ ifeq ($(strip $(my_cc)),)
 endif
 
 SYNTAX_TOOLS_PREFIX := \
-    $(LLVM_PREBUILTS_BASE)/$(BUILD_OS)-x86/$(LLVM_PREBUILTS_VERSION)/libexec
+    $(LLVM_PREBUILTS_BASE)/$(BUILD_OS)-$(HOST_PREBUILT_ARCH)/$(LLVM_PREBUILTS_VERSION)/libexec
 
 ifneq ($(LOCAL_NO_STATIC_ANALYZER),true)
   my_cc := CCC_CC=$(CLANG) CLANG=$(CLANG) \
diff --git a/core/clang/HOST_arm64.mk b/core/clang/HOST_arm64.mk
new file mode 100644
index 0000000..06cdc07
--- /dev/null
+++ b/core/clang/HOST_arm64.mk
@@ -0,0 +1,2 @@
+HOST_LIBPROFILE_RT := $(LLVM_RTLIB_PATH)/libclang_rt.profile-aarch64.a
+HOST_LIBCRT_BUILTINS := $(LLVM_RTLIB_PATH)/libclang_rt.builtins-aarch64.a
diff --git a/core/clang/config.mk b/core/clang/config.mk
index c20cfab..6db065f 100644
--- a/core/clang/config.mk
+++ b/core/clang/config.mk
@@ -1,8 +1,8 @@
 ## Clang configurations.
 
-LLVM_READOBJ := $(LLVM_PREBUILTS_BASE)/$(BUILD_OS)-x86/$(LLVM_PREBUILTS_VERSION)/bin/llvm-readobj
+LLVM_READOBJ := $(LLVM_PREBUILTS_BASE)/$(BUILD_OS)-$(HOST_PREBUILT_ARCH)/$(LLVM_PREBUILTS_VERSION)/bin/llvm-readobj
 
-LLVM_RTLIB_PATH := $(wildcard $(LLVM_PREBUILTS_BASE)/linux-x86/$(LLVM_PREBUILTS_VERSION)/lib/clang/*)/lib/linux/
+LLVM_RTLIB_PATH := $(wildcard $(LLVM_PREBUILTS_BASE)/linux-$(HOST_PREBUILT_ARCH)/$(LLVM_PREBUILTS_VERSION)/lib/clang/*)/lib/linux/
 
 define convert-to-clang-flags
 $(strip $(filter-out $(CLANG_CONFIG_UNKNOWN_CFLAGS),$(1)))
diff --git a/core/envsetup.mk b/core/envsetup.mk
index eb32154..25cc1f2 100644
--- a/core/envsetup.mk
+++ b/core/envsetup.mk
@@ -176,6 +176,11 @@ ifneq (,$(findstring x86_64,$(UNAME)))
   HOST_ARCH := x86_64
   HOST_2ND_ARCH := x86
   HOST_IS_64_BIT := true
+else ifneq (,$(findstring aarch64,$(UNAME))$(findstring arm64,$(UNAME)))
+  # ARM64 Linux host. Soong already treats this as linux_musl-arm64.
+  HOST_ARCH := arm64
+  HOST_2ND_ARCH :=
+  HOST_IS_64_BIT := true
 else
 ifneq (,$(findstring i686,$(UNAME))$(findstring x86,$(UNAME)))
 $(error Building on a 32-bit x86 host is not supported: $(UNAME)!)
@@ -245,7 +250,11 @@ endif
 endif
 
 # We don't want to move all the prebuilt host tools to a $(HOST_OS)-x86_64 dir.
+ifeq ($(HOST_ARCH),arm64)
+HOST_PREBUILT_ARCH := arm64
+else
 HOST_PREBUILT_ARCH := x86
+endif
 # This is the standard way to name a directory containing prebuilt host
 # objects. E.g., prebuilt/$(HOST_PREBUILT_TAG)/cc
 # This must match the logic in get_host_prebuilt_prefix in envsetup.sh
@@ -383,7 +392,12 @@ HOST_OUT_ROOT := $(OUT_DIR)/host
 .KATI_READONLY := SOONG_OUT_DIR HOST_OUT_ROOT
 
 # We want to avoid two host bin directories in multilib build.
+ifeq ($(HOST_ARCH),arm64)
+# Soong builds host tools for arm64 hosts as linux_musl.
+HOST_OUT := $(HOST_OUT_ROOT)/$(HOST_OS)_musl-$(HOST_PREBUILT_ARCH)
+else
 HOST_OUT := $(HOST_OUT_ROOT)/$(HOST_OS)-$(HOST_PREBUILT_ARCH)
+endif
 
 # Soong now installs to the same directory as Make.
 SOONG_HOST_OUT := $(HOST_OUT)
diff --git a/core/install_jni_libs_internal.mk b/core/install_jni_libs_internal.mk
index 4959edd..6fc5b06 100644
--- a/core/install_jni_libs_internal.mk
+++ b/core/install_jni_libs_internal.mk
@@ -40,7 +40,7 @@ ifdef my_embed_jni
     endif
     my_libcxx_arch := $($(LOCAL_2ND_ARCH_VAR_PREFIX)PREBUILT_LIBCXX_ARCH_DIR)
     my_jni_shared_libraries += \
-        $(LLVM_PREBUILTS_BASE)/$(BUILD_OS)-x86/$(LLVM_PREBUILTS_VERSION)/android_libc++/ndk/$(my_libcxx_arch)/lib/libc++_shared.so
+        $(LLVM_PREBUILTS_BASE)/$(BUILD_OS)-$(HOST_PREBUILT_ARCH)/$(LLVM_PREBUILTS_VERSION)/android_libc++/ndk/$(my_libcxx_arch)/lib/libc++_shared.so
   endif
 
   # Set the abi directory used by the local JNI shared libraries.
diff --git a/envsetup.sh b/envsetup.sh
index 453df75..8829645 100644
--- a/envsetup.sh
+++ b/envsetup.sh
@@ -138,7 +138,10 @@ function get_host_prebuilt_prefix
 {
   local un=$(uname)
   if [[ $un == "Linux" ]] ; then
-    echo linux-x86
+    case $(uname -m) in
+      aarch64|arm64) echo linux-arm64 ;;
+      *) echo linux-x86 ;;
+    esac
   elif [[ $un == "Darwin" ]] ; then
     echo darwin-x86
   else
